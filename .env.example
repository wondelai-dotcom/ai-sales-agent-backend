# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_sales_agent?schema=public

# Generate two independent random secrets (at least 32 characters each).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated exact frontend origins. Required in production.
CORS_ORIGINS=http://localhost:5173
# Set to the number of trusted reverse-proxy hops only when deployed behind one.
TRUST_PROXY=0

# Optional integrations. Leave blank until configured.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Transactional email (Resend). Required in production.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
